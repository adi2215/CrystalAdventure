--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bb67a6950aaf40a69b35490170036590, type: 3}
  m_Name: Tutorial_Loops
  m_EditorClassIdentifier: 
  speakerName: Ela
  portrait: {fileID: 21300000, guid: dc1463edfe8eb304a92a7c222c9d1b7f, type: 3}
  steps:
  - text: "Ooh, a new card: LOOP! It repeats other cards for you."
    target: 3
    card: 6
    slot: 0
    wait: 0
    count: 1
    dim: 1
  - text: "Look at this bridge: one step Forward... and then a LOT of steps Right!"
    target: 1
    card: 0
    slot: 0
    wait: 0
    count: 1
    dim: 1
  - text: "First, put one Forward card."
    target: 3
    card: 0
    slot: 0
    wait: 1
    count: 1
    dim: 1
  - text: "Now ONE Right card. Just one!"
    target: 3
    card: 2
    slot: 0
    wait: 1
    count: 1
    dim: 1
  - text: "And now the Loop card, right after them."
    target: 3
    card: 6
    slot: 0
    wait: 1
    count: 1
    dim: 1
  - text: "See the bracket? Everything inside it repeats. But Forward is inside too - we don't want that!"
    target: 4
    card: 0
    slot: 0
    wait: 0
    count: 1
    dim: 1
  - text: "Drag the arrow to the right, so only Right stays inside."
    target: 10
    card: 0
    slot: 0
    wait: 5
    count: 1
    dim: 1
  - text: "Now tap the x2 badge until it shows x6."
    target: 11
    card: 0
    slot: 0
    wait: 6
    count: 6
    dim: 1
  - text: "Six steps Right with just one card. Press Play!"
    target: 6
    card: 0
    slot: 0
    wait: 3
    count: 1
    dim: 1
  - text: "Loops save a lot of cards. Use them whenever something repeats!"
    target: 0
    card: 0
    slot: 0
    wait: 0
    count: 1
    dim: 0
