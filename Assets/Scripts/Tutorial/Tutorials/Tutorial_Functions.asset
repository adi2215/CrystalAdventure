  speakerName: Ela
  portrait: {fileID: 21300000, guid: dc1463edfe8eb304a92a7c222c9d1b7f, type: 3}
  steps:
  - text: "Look, a new card: F1. It is a FUNCTION!"
    target: 3
    card: 4
    slot: 0
    wait: 0
    count: 1
    dim: 1
  - text: "A function is your own little program. Write the moves once, then use them again and again."
    target: 0
    card: 0
    slot: 0
    wait: 0
    count: 1
    dim: 1
  - text: "See the path? It goes like stairs: two steps Forward, two steps Left... and again!"
    target: 1
    card: 0
    slot: 0
    wait: 0
    count: 1
    dim: 1
  - text: "Let's teach these stairs to F1. Open the F1 tab."
    target: 5
    card: 0
    slot: 1
    wait: 2
    count: 1
    dim: 1
  - text: "This is the F1 program. Everything here runs every time F1 is used."
    target: 4
    card: 0
    slot: 1
    wait: 0
    count: 1
    dim: 1
  - text: "Put the Forward card into F1. Two times!"
    target: 3
    card: 0
    slot: 1
    wait: 1
    count: 2
    dim: 1
  - text: "Now the Left card. Also two times!"
    target: 3
    card: 1
    slot: 1
    wait: 1
    count: 2
    dim: 1
  - text: "F1 is ready! Now go back to the Main tab."
    target: 5
    card: 0
    slot: 0
    wait: 2
    count: 1
    dim: 1
  - text: "Add the F1 card. One card = all four moves!"
    target: 3
    card: 4
    slot: 0
    wait: 1
    count: 1
    dim: 1
  - text: "Use F1 again whenever the stairs repeat. Finish the path yourself!"
    target: 0
    card: 0
    slot: 0
    wait: 0
    count: 1
    dim: 0
