  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bb67a6950aaf40a69b35490170036590, type: 3}
  m_Name: Tutorial_Conditions
  m_EditorClassIdentifier: 
  speakerName: Ela
  portrait: {fileID: 21300000, guid: dc1463edfe8eb304a92a7c222c9d1b7f, type: 3}
  steps:
  - text: "Look, RED tiles! They are special."
    target: 12
    card: 0
    slot: 0
    wait: 0
    count: 1
    dim: 1
  - text: "Cards can be painted. A painted card works ONLY when the cube stands on its color."
    target: 0
    card: 0
    slot: 0
    wait: 0
    count: 1
    dim: 1
  - text: "Put a Forward card."
    target: 3
    card: 0
    slot: 0
    wait: 1
    count: 1
    dim: 1
  - text: "Now a Right card."
    target: 3
    card: 2
    slot: 0
    wait: 1
    count: 1
    dim: 1
  - text: "Tap the red paint to pick it up."
    target: 13
    card: 0
    slot: 0
    wait: 8
    count: 1
    dim: 1
  - text: "Now tap the Right card to paint it."
    target: 14
    card: 2
    slot: 0
    wait: 7
    count: 1
    dim: 1
  - text: "A red Right works only on red tiles. Everywhere else it is skipped!"
    target: 4
    card: 0
    slot: 0
    wait: 0
    count: 1
    dim: 1
  - text: "Add the Loop card."
    target: 3
    card: 6
    slot: 0
    wait: 1
    count: 1
    dim: 1
  - text: "Make it x6."
    target: 11
    card: 0
    slot: 0
    wait: 6
    count: 6
    dim: 1
  - text: "Each round: step Forward, and step Right only on red. Press Play!"
    target: 6
    card: 0
    slot: 0
    wait: 3
    count: 1
    dim: 1
  - text: "Painted cards are the IF of real code. A red card next to a blue card is if / else!"
    target: 0
    card: 0
    slot: 0
    wait: 0
    count: 1
    dim: 0
